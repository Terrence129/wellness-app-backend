          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('upsert personal info returns 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('personal info response includes calculated BMI', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.heightCm).to.eql(172.5);",
                  "  pm.expect(body.data.weightKg).to.eql(68.4);",
                  "  pm.expect(body.data.bmi).to.eql(23.0);",
                  "});",
                  "pm.environment.set('personalInfoId', String(body.data.id));"
