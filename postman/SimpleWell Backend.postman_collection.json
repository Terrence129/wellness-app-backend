          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('login returns token', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('token', body.data.token);",
                  "pm.environment.set('userId', String(body.data.user.id));"
                ]
              }
            }
          ]
        }
