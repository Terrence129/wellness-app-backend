                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logDate\": \"{{newLogDate}}\",\n  \"sleepHours\": 7.5,\n  \"moodScore\": 4,\n  \"waterCups\": 6,\n  \"steps\": 8000,\n  \"exerciseMinutes\": 30,\n  \"note\": \"Created from Postman.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wellness-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wellness-logs"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = new Date(Date.UTC(2030, 0, 1));",
                  "base.setUTCDate(base.getUTCDate() + Math.floor(Date.now() / 1000) % 20000);",
                  "pm.environment.set('newLogDate', base.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create log returns 201 or duplicate conflict', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('logId', String(body.data.id));",
                  "  pm.environment.set('logDate', body.data.logDate);",
                  "}"
                ]
              }
            }
          ]
        },
