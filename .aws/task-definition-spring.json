{
  "family": "simplewell-spring-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::150619449855:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::150619449855:role/simplewell-spring-task-role",
  "containerDefinitions": [
    {
      "name": "simplewell-spring",
      "image": "150619449855.dkr.ecr.ap-southeast-1.amazonaws.com/simplewell-spring-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "name": "spring",
          "containerPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "DB_URL",
          "value": "jdbc:mysql://<rds-endpoint>:3306/wellness-app?useSSL=true&serverTimezone=Asia/Singapore&allowPublicKeyRetrieval=true"
        },
        {
          "name": "AI_SERVICE_BASE_URL",
          "value": "http://wellness-ai:8000"
        }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:150619449855:secret:simplewell/prod/db-username"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:150619449855:secret:simplewell/prod/db-password"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:150619449855:secret:simplewell/prod/jwt-secret"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/simplewell-spring",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}